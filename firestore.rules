rules_version = '2';

// The Field Manual — newsletter subscribers.
// Public signup form writes here; reads/writes/updates/deletes are closed.
// The scheduled email job reads the list server-side via the Firestore API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /subscribers/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['name', 'email', 'createdAt', 'source'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, update, delete: if false;
    }
    // Personal source adder. Visitors submit URLs; the pipeline scrapes
    // pending docs server-side and flips them to scraped/failed.
    // Reads are get-by-ID only: a visitor can check the status of a
    // submission they made (its doc ID is stored in their browser's
    // localStorage), but nobody can LIST the collection — listing would
    // expose every submitted URL and submitter email. The doc ID is a
    // random 20-char Firestore ID, so knowing it is the capability.
    // Per-user scoping of *content* is enforced pipeline-side: a scraped URL
    // only ever appears in its submitter's email, never the global edition.
    match /user_sources/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['email', 'url', 'title', 'addedAt', 'status'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.url is string
        && request.resource.data.url.size() >= 12
        && request.resource.data.url.size() <= 2000
        && request.resource.data.url.matches('^https?://\\S+$')
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.status == 'pending'
        && request.resource.data.addedAt is timestamp;
      allow get: if true;
      allow list: if false;
      allow update, delete: if false;
    }
    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
